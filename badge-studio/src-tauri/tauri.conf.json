{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Badge Studio",
  "version": "1.0.20",
  "identifier": "com.martin.badge-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Badge Studio",
        "width": 1280,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["badge"],
        "name": "BadgeStudioProject",
        "description": "Badge Studio project",
        "role": "Editor",
        "mimeType": "application/x-badge-studio-project"
      },
      {
        "ext": ["badgemsg"],
        "name": "BadgeStudioMessage",
        "description": "Badge Studio message",
        "role": "Editor",
        "mimeType": "application/x-badge-studio-message"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
